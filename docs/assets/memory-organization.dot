digraph MemoryOrganization {
  graph [rankdir=TB, ordering=out, bgcolor="#F8FAFC", pad="0.35", nodesep="0.32", ranksep="0.65",
         fontname="Noto Sans CJK SC", fontsize=24, fontcolor="#0F172A", labelloc=t,
         label="NPC 记忆组织层次图\n五类并列职责与实际存储的映射 · 当前实现 / 2026-11-06"];
  node [shape=box, style="rounded,filled", fillcolor="white", color="#CBD5E1",
        penwidth=1.3, fontname="Noto Sans CJK SC", fontsize=13, fontcolor="#334155", margin="0.22,0.17"];
  edge [color="#64748B", penwidth=1.3, arrowsize=0.75,
        fontname="Noto Sans CJK SC", fontsize=11, fontcolor="#475569"];

  npc [label="单个 NPC\nNPC.memory_categories()：组合五类内部快照", fillcolor="#0F172A", fontcolor="white", fontsize=17, color="#0F172A"];

  subgraph cluster_categories {
    label="";
    color="#E2E8F0"; style="rounded"; margin=18;
    persona [label="人格核心\npersona_core\n────────────\n姓名与人格数值\n背景、价值观、底线\n表达风格、长期动机、版本\n显式配置和版本更新", fillcolor="#FFF7ED", color="#FDBA74"];
    state [label="当前状态\ncurrent_state\n────────────\n当前时钟与认知档位\nPlanState / 当前活动\n中断说明与有效 plan\n运行态及记录的组合副本", fillcolor="#EFF6FF", color="#93C5FD"];
    semantic [label="长期语义记忆\nsemantic\n────────────\nreflection / identity\n自我和关系判断\n可修正的身份信念\n保留 evidence 与 confidence", fillcolor="#F5F3FF", color="#C4B5FD"];
    episodic [label="情节记忆\nepisodic\n────────────\nobservation / episode\n具体观察与交互经历\n情节摘要及其证据\n可合并、固化或降权", fillcolor="#F0FDFA", color="#5EEAD4"];
    raw [label="原文档案\nraw_archive\n────────────\n实际输入、对话、动作\n生成内容的来源记录\n稳定来源 ID 与事件引用\n追加保存，按范围读取", fillcolor="#FFF1F2", color="#FDA4AF"];
    {rank=same; persona; state; semantic; episodic; raw;}
    persona -> state -> semantic -> episodic -> raw [style=invis, weight=100];
  }

  npc -> {persona state semantic episodic raw};

  subgraph cluster_storage {
    label="";
    color="#CBD5E1"; fillcolor="#F1F5F9"; style="rounded,filled"; margin=20;
    live [label="NPC 运行对象\nRuntimeState / PlanState\n持有时钟、档位及当前计划\n读取快照不会暴露可写状态", fillcolor="#DBEAFE", color="#93C5FD"];
    db [label="派生记忆主库  <NPC>.db\nmeta：人格配置及保存的运行字段\nmemory：plan / reflection / identity / observation / episode\nevidence：记忆之间的证据 ID\nmemory_source：派生记忆与原文来源关联", fillcolor="white", color="#94A3B8"];
    archive [label="原文档案库  <NPC>.archive.db\nsource / processing：原文与补处理状态\nevent：结构化事件与参与者\nchunk / FTS5：片段与全文索引\nchunk_vector：编码器、维度、版本及持久向量", fillcolor="white", color="#94A3B8"];
    {rank=same; live; db; archive;}
    live -> db [style=dashed, label="保存 / 恢复", color="#3B82F6"];
    db -> archive [style=dashed, label="source_refs → 原文 ID", color="#0D9488"];
  }

  persona -> db [label="npc 元数据"];
  state -> live [label="当前运行态"];
  state -> db [label="有效 plan 记录"];
  semantic -> db;
  episodic -> db;
  raw -> archive;

  note [shape=box, color="#E2E8F0", fillcolor="#FFFFFF", fontsize=12,
        label="近期优先、重要性、按需检索和预算是读取策略，不是另一套记忆类别。\nidentity 是可修正信念，不会自动覆盖人格核心；当前状态尚未自动维护情绪或承诺。\n原文先归档；派生记忆合并、降权或失效不删除原文。五类快照不会自动完整注入各生成出口。"];
  live -> note [style=invis]; db -> note [style=invis]; archive -> note [style=invis];
}
