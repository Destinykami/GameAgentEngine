digraph MemoryRetrieval {
  graph [rankdir=TB, ordering=out, bgcolor="#F8FAFC", pad="0.35", nodesep="0.38", ranksep="0.48",
         fontname="Noto Sans CJK SC", fontsize=24, fontcolor="#0F172A", labelloc=t,
         label="记忆检索流程图\n当前普通对话 → 统一混合检索 → 有界上下文 / 2026-11-06"];
  node [shape=box, style="rounded,filled", fillcolor="white", color="#CBD5E1",
        penwidth=1.3, fontname="Noto Sans CJK SC", fontsize=13, fontcolor="#334155", margin="0.22,0.15"];
  edge [color="#64748B", penwidth=1.3, arrowsize=0.75,
        fontname="Noto Sans CJK SC", fontsize=11, fontcolor="#475569"];

  input [label="用户原始问题\nDialogueManager / build_context", fillcolor="#0F172A", fontcolor="white", fontsize=16];
  background [label="有界读取近期背景与语义概况\nworking_memories：当前对象 + NPC 共享流\n不刷新 last_accessed", fillcolor="#EFF6FF", color="#93C5FD"];
  route [shape=diamond, label="是否进行检索？", fillcolor="#EFF6FF", color="#93C5FD"];
  skip [label="空输入 / 明确寒暄 / 不再提旧事\n只用背景；不查询历史向量", fillcolor="#F1F5F9"];
  prepare [label="其他信息查询 → hybrid_retrieve\n原问题完整保留；检索词最多 4000 字符\n对话：top_k ≤ 8，candidate_k = 32", fillcolor="#DBEAFE", color="#60A5FA"];
  scope [label="先校验硬范围与显式条件\nNPC 自有库 / 当前对象及可选共享流 / 时间上界\n对话严格排除本轮时间，且只查非实例原文\n核心接口可显式限定游戏实例和 EventQuery", fillcolor="#E0F2FE", color="#38BDF8"];
  error [label="非法范围或不可见锚点\n直接报错，不放宽范围", fillcolor="#FFF1F2", color="#FDA4AF"];
  input [group="main"]; background [group="main"]; route [group="main"];
  prepare [group="main"]; scope [group="main"];

  input -> background -> route;
  route -> skip [label="不检索"];
  route -> prepare [label="检索", weight=20];
  prepare -> scope [weight=20];
  scope -> error [style=dashed, color="#E11D48", label="校验失败", constraint=false];
  {rank=same; scope; error;}

  subgraph cluster_recall {
    label="";
    color="#CBD5E1"; style="rounded"; margin=20;
    lexical [label="关键词路线\n原文片段 FTS5 / BM25\n每个来源保留最佳命中\n不要求高 importance 或近期", fillcolor="#F0FDFA", color="#5EEAD4"];
    dense [label="向量路线\n编码查询 → 限批补建片段向量\n查询默认最多补 64 个可见片段\n流式扫描已有向量，按来源保留最佳片段", fillcolor="#EFF6FF", color="#93C5FD"];
    hint [label="有效摘要 / 反思提示路线\nreflection / identity / episode\n沿 evidence 和来源关联回到原文\n重验范围；无证据或失效则忽略\n实例查询不借用旧主库提示", fillcolor="#F5F3FF", color="#C4B5FD"];
    structured [label="显式结构化路线 · 可选\n事件类型 / 人物 / 地点 / 时间 / 锚点\n仅在调用方传入 EventQuery 时启用\n不会自动理解自然语言第 N 次", fillcolor="#FFF7ED", color="#FDBA74"];
    {rank=same; lexical; dense; hint; structured;}
    lexical -> dense -> hint -> structured [style=invis, weight=10];
  }
  scope -> lexical;
  scope -> dense;
  scope -> hint;
  scope -> structured [style=dashed, label="显式 filters"];

  diagnostics [label="索引完整性 / 失败诊断\n未补完：dense_complete = false\n编码失败：保留可用召回并记录原因\nSQL / 权限错误仍直接传播", fillcolor="#FFFBEB", color="#FCD34D"];
  dense -> diagnostics [style=dashed, color="#D97706"];

  fusion [label="按原文来源归并 + RRF 排名融合\nk = 60；每来源、每路只投一次票\n摘要帮助定位证据，不新增独立事实\n保留有限候选，再校验范围并读取片段", fillcolor="#EDE9FE", color="#A78BFA"];
  fusion [group="main"];
  {rank=same; fusion; diagnostics;}
  lexical -> fusion; dense -> fusion; hint -> fusion; structured -> fusion [style=dashed];
  rerank [label="可选重排端口\n默认未配置专用 reranker\n只允许给已有候选返回分数", fillcolor="#F1F5F9", color="#94A3B8"];
  rerank [group="main"];
  select [label="选择最多 top_k 条核心证据 hits\n保留来源、排名、source_id\n以及 start / end 片段偏移", fillcolor="#ECFDF5", color="#6EE7B7"];
  select [group="main"];
  neighbors [label="命中后展开有限邻文 neighbors\n同会话、同范围、非未来\n对话半径 = 1；核心接口默认 = 0\n邻文单独返回，不挤占核心命中名额", fillcolor="#F0FDFA", color="#5EEAD4"];
  neighbors [group="main"];
  fusion -> rerank [style=dashed, label="可选；未配置则直通"];
  rerank -> select [weight=20];
  select -> neighbors [weight=20];

  pack [label="来源去重与上下文预算\n顺序：核心命中 → 邻文 → 近期背景\n共用 3000 字符；单条最多 800 字符\n片段未完整覆盖来源时，保留额外观察信息", fillcolor="#DBEAFE", color="#60A5FA"];
  pack [group="main"];
  neighbors -> pack [weight=20];
  skip -> pack [label="背景旁路"];
  output [label="LLMContext → 生成回复\n原始问题 + 名称 / 人格数值 + 预算内记忆\n不刷新候选访问时间，不把提问当历史证据", fillcolor="#0F172A", fontcolor="white", fontsize=15];
  output [group="main"];
  metadata [label="发生检索时，诊断附在 ctx.extra.retrieval\n覆盖率、各路命中、降级原因、耗时\n不作为历史事实注入", fillcolor="#FFFBEB", color="#FCD34D"];
  pack -> output [weight=20];
  output -> metadata [style=dashed, color="#D97706", constraint=false];
  {rank=same; output; metadata;}

  note [label="图示以默认 hybrid 模式为主；bm25 不编码查询，dense 不走词法路线。\n未实现：自动指代解析、自然语言第 N 次规划、ANN；游戏默认仍使用本局近期事件窗口。\n并排召回表示逻辑分路，不代表当前代码已并发执行。\n实线表示主流程；虚线表示可选、辅助或诊断关系。", fontsize=12, fillcolor="white", color="#E2E8F0"];
  output -> note [style=invis];
}
